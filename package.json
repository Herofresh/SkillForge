{
  "name": "skillforge",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/alegreya-sans": "^0.4.2",
    "@expo-google-fonts/pixelify-sans": "^0.4.2",
    "@expo-google-fonts/silkscreen": "^0.4.2",
    "@expo/ui": "~57.0.20",
    "drizzle-orm": "^0.45.3",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "test-renderer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "progressions:check": "tsx scripts/progressions.ts check",
    "progressions:build": "tsx scripts/progressions.ts build",
    "progressions:review": "tsx scripts/progressions.ts review",
    "e2e": "node scripts/e2e.ts",
    "db:generate": "drizzle-kit generate",
    "lockfile:check": "node scripts/lockfile.ts check",
    "lockfile:fix": "node scripts/lockfile.ts fix",
    "build:apk": "tsx scripts/buildApk.ts",
    "build:apk:universal": "tsx scripts/buildApk.ts --universal",
    "icon:build": "tsx scripts/iconBuild.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^yaml$": "<rootDir>/node_modules/yaml/dist/index.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "warn"
    }
  }
}

{
  "expo": {
    "name": "SkillForge",
    "slug": "skillforge",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skillforge",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "permissions": ["android.permission.VIBRATE"],
      "adaptiveIcon": {
        "backgroundColor": "#0D0B14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "at.skillforge.app",
      "versionCode": 5
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0B14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/jersey-15/400Regular/Jersey15_400Regular.ttf",
            "./node_modules/@expo-google-fonts/silkscreen/400Regular/Silkscreen_400Regular.ttf"
          ],
          "widgets": [
            {
              "name": "SkillForge",
              "label": "SkillForge",
              "description": "Trained today, streak, level and rank",
              "minWidth": "130dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
